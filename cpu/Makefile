# 项目模块名称
FRAME ?= pipeline-FPU
ARCH = riscv32-newcore

# --- kconfig configuration ---
# Override env var to ensure correct path
override NEW_CORE_HOME := $(abspath .)
KCONFIG_PATH := $(NEW_CORE_HOME)/tools/kconfig
FIXDEP_PATH  := $(NEW_CORE_HOME)/tools/fixdep
Kconfig       := $(NEW_CORE_HOME)/Kconfig

CONF   := $(KCONFIG_PATH)/build/conf
MCONF  := $(KCONFIG_PATH)/build/mconf
FIXDEP := $(FIXDEP_PATH)/build/fixdep

# Include variables and rules generated by menuconfig
-include $(NEW_CORE_HOME)/include/config/auto.conf
-include $(NEW_CORE_HOME)/include/config/auto.conf.cmd

# Warn if .config does not exist
ifeq ($(wildcard $(NEW_CORE_HOME)/.config),)
$(warning ==================================================)
$(warning Warning: .config does not exist!)
$(warning To build the project, first run `make menuconfig`.)
$(warning Or run `make defconfig` for default configuration.)
$(warning ==================================================)
endif
# --- end kconfig configuration ---
ifeq ($(ARCH), riscv32-newysyxsoc)
TOP_MODULE = ysyxSoCFull
YOSYS_TOP = ysyx_25010030
CXXFLAGS += -DYSYXSOC
NXDC_FILES = ./$(FRAME)/constr/ysyxSoCFull.nxdc
else ifeq ($(ARCH), riscv32-newcore)
TOP_MODULE = ysyx_25010030_npc
CXXFLAGS += -DNPC
YOSYS_TOP = ysyx_25010030
else
$(error 不支持的架构：$(ARCH).支持的架构: riscv32-newysyxsoc, riscv32-newcore)
endif

nvboard ?= 1
# diff: auto-detect from menuconfig unless explicitly set
ifeq ($(origin diff),undefined)
  ifeq ($(CONFIG_DIFFTEST),y)
  diff = 1
  else
  diff = 0
  endif
endif
ifeq ($(ARCH), riscv32-newysyxsoc)
CSRCS = $(shell find $(abspath ./$(FRAME)/csrc) -name "*.cpp")  #可修改
VSRCS = $(shell find $(abspath ./$(FRAME)/vsrc) -name "*.v")
VSRCS += $(shell find $(abspath ../ysyxSoC/perip) -name "*.v")
VSRCS += ../ysyxSoC/build/ysyxSoCFull.v 

else
ifeq ($(ARCH), riscv32-newcore)
CSRCS = $(shell find $(abspath ./$(FRAME)/csrc) -name "*.cpp") #可修改
VSRCS = $(shell find $(abspath ./$(FRAME)/vsrc) -name "*.v")
# VSRCS += $(shell find $(abspath ./$(FRAME)/vsrc) -name "*.vh")
# VSRCS = $(shell find $(abspath ./$(FRAME)/build) -name "*.v")
VSRCS += $(shell find $(abspath ./$(FRAME)/simple-SoC) -name "*.v")
# pipeline-FPU 直接引用 FPU rtl/ 作为唯一 RTL 来源
ifeq ($(FRAME), pipeline-FPU)
VSRCS += $(shell find $(abspath $(NEW_CORE_HOME)/../rtl) -name "*.v")
endif
endif
endif

VVP = vvp
VERILATOR = verilator
VERILATOR_FLAGS += -cc --exe
VERILATOR_FLAGS += --public --public-flat-rw
VERILATOR_FLAGS += -MMD
VERILATOR_FLAGS += --trace
VERILATOR_FLAGS += -Wno-STMTDLY -Wno-MODDUP -Wno-fatal
# 原始核(bpu/tage/ittage/mdu 等)沿用的编码风格: 顺序块内阻塞赋值与预留信号
VERILATOR_FLAGS += -Wno-BLKSEQ -Wno-UNUSEDSIGNAL

BUILD_DIR = ./build
IVERILOG = iverilog
IVERILOG_DIR = $(BUILD_DIR)/iverilog
WAVEFORM = $(IVERILOG_DIR)/waveform.fst
WAVEFORM_NETLIST = $(IVERILOG_DIR)/waveform_netlist.fst
MEM_INIT = $(IVERILOG_DIR)/mem_init.hex

IMG ?=

CELLS ?= ../yosys-sta/nangate45/sim/cells.v
NETLIST ?= ../yosys-sta/result/ysyx_25010030-250MHz/ysyx_25010030.netlist.fixed.v
IVERILOG_BIN = $(IVERILOG_DIR)/sim
IVERILOG_BIN_NETLIST = $(IVERILOG_DIR)/sim_netlist
IVERILOG_FLAGS += -Wall -g2012 -s sim_top -o $(IVERILOG_BIN) \
    -I./$(FRAME)/vsrc \
	-DNPC \
    -DWAVE=$(WAVE) \
    -DMEM_INIT_PATH=\"$(MEM_INIT)\" \
    -DWAVEFORM_PATH=\"$(WAVEFORM)\"

IVERILOG_NETLIST_FLAGS += -Wall -g2012 -s sim_top -o $(IVERILOG_BIN) \
    -I./$(FRAME)/vsrc \
	-DNPC \
    -DWAVE=$(WAVE) \
    -DMEM_INIT_PATH=\"$(MEM_INIT)\" \
    -DWAVEFORM_PATH=\"$(WAVEFORM_NETLIST)\"
	
WAVE ?= 0
ifeq ($(WAVE), 1)
IVERILOG_VVP_FLAGS = -lxt2  # 生成波形文件
else
IVERILOG_VVP_FLAGS =        # 不生成波形文件
endif

VERILOG_MERGED = $(BUILD_DIR)/ysyx_25010030.v
$(VERILOG_MERGED): $(wildcard ./$(FRAME)/vsrc/*.v) $(wildcard ./$(FRAME)/vsrc/*.vh)
	@echo "Merging core Verilog files into $@..."
# 	@echo "// Merged Verilog file with PC reset value 0x30000000" > $@
# 	@echo \`define RESET_VAL 0 >> $@
	@echo \`define __ICARUS__ 0 >> $@
	@echo "" >> $@
	
	@for file in $(wildcard ./$(FRAME)/vsrc/*.vh); do \
		echo "// Included from $$file" >> $@; \
		cat $$file >> $@; \
		echo "" >> $@; \
	done
	
	@for file in $(wildcard ./$(FRAME)/vsrc/*.v); do \
		echo "// Included from $$file" >> $@; \
		cat $$file | sed -e '/`include "ysyx_25010030_define.vh"/d' >> $@; \
		echo "" >> $@; \
	done

$(IVERILOG_BIN): ARCH=riscv32-newcore
$(IVERILOG_BIN): TOPNAME=ysyx_25010030_npc
$(IVERILOG_BIN): $(VERILOG_MERGED) \
                 $(wildcard ./simple-SoC/*.v) \
                 ./sim_top.v
	@echo "Building iverilog simulation for NPC architecture..."
	$(IVERILOG) $(IVERILOG_FLAGS) $^

$(IVERILOG_BIN_NETLIST): ARCH=riscv32-newcore
$(IVERILOG_BIN_NETLIST): TOPNAME=ysyx_25010030_npc
$(IVERILOG_BIN_NETLIST): $(NETLIST) \
                         $(CELLS) \
                 		 $(wildcard ./simple-SoC/*.v) \
                         ./sim_top.v
	@echo "Building iverilog netlist simulation (NETLIST=$(NETLIST), CELLS=$(CELLS))..."
	$(IVERILOG) $(IVERILOG_NETLIST_FLAGS) \
		-DWAVEFORM_PATH=\"$(WAVEFORM_NETLIST)\" \
		-o $@ $^

$(MEM_INIT): $(IMG)
	@echo "Generating memory init from BIN..."
	riscv64-linux-gnu-objcopy -I binary -O verilog --adjust-vma=-0x00000000 $^ $@

ifeq ($(ARCH), riscv32-newysyxsoc)
VERILATOR_FLAGS += +incdir+../ysyxSoC/perip/uart16550/rtl +incdir+../ysyxSoC/perip/spi/rtl 
VERILATOR_FLAGS += --timescale "1ns/1ns" --no-timing
VERILATOR_FLAGS += -DYSYXSOC
else
VERILATOR_FLAGS += -DNPC
# VERILATOR_FLAGS += +define+ENABLE_FMA_DEBUG
endif
VERILATOR_FLAGS += --build -Mdir $(OBJ_DIR)
VERILATOR_FLAGS += -I$(NEW_CORE_HOME)/$(FRAME)/vsrc #可修改
ifeq ($(FRAME), pipeline-FPU)
VERILATOR_FLAGS += -I$(abspath $(NEW_CORE_HOME)/../rtl) # fpu_config.vh 查找路径
endif

ifeq ($(diff), 1)
VERILATOR_FLAGS += -DDIFFTEST
CXXFLAGS += -DCONFIG_DIFFTEST
endif

OBJ_DIR = ./obj_dir
BIN = $(OBJ_DIR)/V$(TOP_MODULE)

INC_PATH = $(NEW_CORE_HOME)/$(FRAME)/include/
INCFLAGS = $(addprefix -I, $(INC_PATH))
INCFLAGS += -I$(NEW_CORE_HOME)/include/generated
CXXFLAGS += $(INCFLAGS) -DTOP_NAME="\"V$(TOP_MODULE)\""
CXXFLAGS += -g

# 链接的库
LIBS = -lreadline  # 链接 readline 库, 命令行交互库
LIBS += -ldl       # 链接 dlfcn 库, 动态链接库
LIBS += -lSDL2     # 添加 SDL2 库链接, 图形显示库
LIBS += -lSDL2_image
LDFLAGS += $(LIBS)

ifeq ($(diff), 1)
DIFF_REF_PATH = $(NEMU_HOME)/build
# DIFF_REF_PATH = /home/furina/ysyx-workbench/nemu/build
DIFF_REF_SO = $(DIFF_REF_PATH)/riscv32-nemu-interpreter-so
ARGS_DIFF = --diff=$(DIFF_REF_SO)
endif

$(DIFF_REF_SO):
	$(MAKE) -s -C $(DIFF_REF_PATH)

# 参数设置

# 直接在本目录运行也要能出波形: 默认批量(-b)模式执行.
#   - 未指定 TEST/IMG 时运行内置小镜像(li/auipc/addi/ebreak), 快速 GOOD TRAP 出波
#   - `make run TEST=xxx` / `make wave.vcd TEST=xxx` 自动构建软件镜像并运行
TEST ?=
SOFTWARE_DIR ?= $(NEW_CORE_HOME)/../software
SW_TARGET  := $(if $(wildcard $(SOFTWARE_DIR)/test/$(TEST).c),test,asm)
SW_OUT_DIR := $(if $(filter test,$(SW_TARGET)),test,asm-test)
SW_BIN     := $(SOFTWARE_DIR)/build/$(SW_OUT_DIR)/$(TEST).bin
ifeq ($(strip $(IMG)),)
override IMG := $(if $(TEST),$(abspath $(SW_BIN)),)
endif

$(SW_BIN):
	$(MAKE) -s -C $(SOFTWARE_DIR) $(SW_TARGET) TEST=$(TEST)

# SW_BIN is a file target with no prerequisites; force the (re)build every
# invocation so an edited test/*.c or asm-test/*.S is always recompiled.
.PHONY: $(SW_BIN)

override ARGS ?= -b --log=$(OBJ_DIR)/npc-log.txt
override ARGS += $(ARGS_DIFF)
NPC_EXEC = $(BIN) $(ARGS) $(IMG)

ifdef mainargs
ASFLAGS += -DBIN_PATH=\"$(mainargs)\"
# @echo "### Get mainargs ###"
endif

default: $(BIN)
$(shell mkdir -p $(OBJ_DIR) $(BUILD_DIR) $(IVERILOG_DIR))

ifeq ($(ARCH), riscv32-newysyxsoc)
ifeq ($(nvboard), 1)
CXXFLAGS += -DNVBOARD
SRC_AUTO_BIND = $(abspath $(OBJ_DIR)/auto_bind.cpp)
$(SRC_AUTO_BIND): $(NXDC_FILES)
	@echo "### 生成NVBoard引脚绑定代码 ###"
	python3 $(NVBOARD_HOME)/scripts/auto_pin_bind.py $^ $@
include $(NVBOARD_HOME)/scripts/nvboard.mk
CSRCS += $(SRC_AUTO_BIND)
endif
endif

.PHONY: sim-iverilog sim-iverilog-netlist
sim-iverilog: $(MEM_INIT) $(IVERILOG_BIN)
	@echo "Running iverilog simulation $(IMG) (WAVE=$(WAVE))..."
	$(VVP) -n $(IVERILOG_BIN) $(IVERILOG_VVP_FLAGS)
	@if [ $(WAVE) -eq 1 ] && [ -f $(WAVEFORM) ]; then \
		echo "Waveform: $(WAVEFORM)"; \
	fi

sim-iverilog-netlist: $(MEM_INIT) $(IVERILOG_BIN_NETLIST)
	@echo "Running iverilog netlist simulation (WAVE=$(WAVE))..."
	$(VVP) -n $(IVERILOG_BIN_NETLIST) $(IVERILOG_VVP_FLAGS)
	@if [ $(WAVE) -eq 1 ] && [ -f $(WAVEFORM_NETLIST) ]; then \
		echo "Netlist Simulation Waveform: $(WAVEFORM_NETLIST)"; \
	fi

# 伪目标：仿真
.PHONY: sim
sim: wave.vcd

# 伪目标：查看波形
.PHONY: waves
waves: wave.vcd
	@echo
	@echo "### WAVES ###"
	gtkwave wave.vcd

#生成波形文件
.PHONY: wave.vcd
wave.vcd: $(BIN) $(if $(TEST),$(SW_BIN))
	@echo
	@echo "### SIMULATING ###"
	$(NPC_EXEC) #+verilator+rand+reset+2

# 伪目标：运行环境准备
.PHONY: run-env
run-env: $(BIN) $(DIFF_REF_SO)

# 伪目标：运行仿真
.PHONY: run
run: run-env $(if $(TEST),$(SW_BIN))
	$(NPC_EXEC)

.PHONY: verilog
verilog: $(VERILOG_MERGED)
	@echo "Generated merged Verilog file: $(VERILOG_MERGED)"

# 伪目标：构建
.PHONY: build
build: $(BIN)

$(BIN): $(VSRCS) $(CSRCS) $(NVBOARD_ARCHIVE) $(SRC_AUTO_BIND)
# 	@rm -rf $(OBJ_DIR)
	$(VERILATOR) $(VERILATOR_FLAGS) \
		--top-module $(TOP_MODULE) $^ \
		$(addprefix -CFLAGS , $(CXXFLAGS)) $(addprefix -LDFLAGS , $(LDFLAGS)) \
		--Mdir $(OBJ_DIR) --exe -o $(abspath $(BIN))


# 伪目标：Lint 检查
# BLKSEQ/UNUSEDSIGNAL 为原始核(bpu/tage/ittage/mdu 等)沿用风格, 显式屏蔽
.PHONY: lint
lint:
	verilator --lint-only -Wall --top-module ysyx_25010030 \
			-Wno-BLKSEQ -Wno-UNUSEDSIGNAL \
			$(shell find $(abspath ./$(FRAME)/vsrc) -name "*.v") \
			$(shell find $(abspath ./../rtl) -name "*.v") \
			-I$(NEW_CORE_HOME)/$(FRAME)/vsrc \
			-I$(abspath ./../rtl)

# 伪目标：清理
.PHONY: clean
clean:
	rm -rf .stamp.*
	rm -rf $(OBJ_DIR)
	rm -rf $(BUILD_DIR)
	rm -rf *.vcd
	rm -rf *.fst
	rm -rf ./log/*
	rm -rf mtrace.log

.PHONY: wave
wave:
	gtkwave wave.vcd

# --- kconfig targets ---
Q := @
silent := -s

$(CONF):
	$(Q)$(MAKE) $(silent) -C $(KCONFIG_PATH) NAME=conf

$(MCONF):
	$(Q)$(MAKE) $(silent) -C $(KCONFIG_PATH) NAME=mconf

$(FIXDEP):
	$(Q)$(MAKE) $(silent) -C $(FIXDEP_PATH)

menuconfig: $(MCONF) $(CONF) $(FIXDEP)
	$(Q)$(MCONF) $(Kconfig)
	$(Q)$(CONF) $(silent) --syncconfig $(Kconfig)

savedefconfig: $(CONF)
	$(Q)$< $(silent) --savedefconfig=configs/defconfig $(Kconfig)

defconfig: $(CONF) $(FIXDEP)
	$(Q)if [ -s configs/defconfig ]; then \
		$< $(silent) --defconfig=configs/defconfig $(Kconfig); \
	else \
		$< $(silent) --alldefconfig $(Kconfig); \
	fi
	$(Q)$< $(silent) --syncconfig $(Kconfig)

distclean: clean
	-@rm -rf include/generated include/config .config .config.old

# Help text
help:
	@echo  '  menuconfig      - Update current config utilising a menu based program'
	@echo  '  defconfig       - New config with default answer to all options'
	@echo  '  savedefconfig   - Save current config as configs/defconfig (minimal config)'
	@echo  '  distclean       - Remove all generated files including .config'

.PHONY: menuconfig savedefconfig defconfig distclean help